# Copiá este archivo como .env y completá tus claves reales.
# El archivo .env está en .gitignore: NUNCA se sube a GitHub.

# Anthropic: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de Claude que usa el agente (uno barato alcanza)
ANTHROPIC_MODEL=claude-haiku-5-5

# Pinecone: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=pcsk_...
# Índice y namespace creados en la Pre-entrega 4 (documentación de httpx)
INDEX_NAME=pre-entrega-4
PINECONE_NAMESPACE=httpx-docs
